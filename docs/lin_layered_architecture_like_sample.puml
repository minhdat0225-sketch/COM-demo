@startuml
title AUTOSAR LIN TX - Layered Architecture Diagram
top to bottom direction
skinparam shadowing false
skinparam dpi 180
skinparam packageStyle rectangle
skinparam defaultTextAlignment center
skinparam linetype polyline
skinparam ArrowColor #4A4A4A
skinparam ArrowThickness 1.2
skinparam ArrowFontColor #222222
skinparam ArrowFontSize 14
skinparam PackageBorderColor #7A7A7A
skinparam PackageBackgroundColor #FBFBFB
skinparam PackageFontColor #222222
skinparam PackageFontSize 18
skinparam RectangleBorderColor #8A8A8A
skinparam RectangleBackgroundColor #F3F3F3
skinparam RectangleFontSize 16
skinparam RectangleFontColor #111111
skinparam NoteBackgroundColor #FFFBEA
skinparam NoteBorderColor #D4A017

package "1. Application Layer" as L1 {
  rectangle "lin_tx_demo.c\nmain() - LIN Master Demo" as App
}

package "2. Service Layer" as L2 {
  rectangle "Com.c - COM Module\nShadow Buffer / Signal Packing" as Com
  rectangle "PduR.c - PDU Router\nTriggerTx / TxConf" as PduR
}

package "3. ECU Abstraction Layer" as L3 {
  rectangle "LinIf.c - LIN Interface\nScheduler + Pull" as LinIf
}

package "4. MCAL Layer" as L4 {
  rectangle "Lin.c - LIN Driver\nUSART2 LIN Mode" as Lin
}

package "5. Hardware Layer" as L5 {
  rectangle "STM32F103 USART2 + LIN Transceiver\nRegisters / PA2-PA3 / LIN Bus" as Hw
}

package "6. Configuration Files" as L6 {
  rectangle "Com_Cfg.c\nCom_SignalCfg / Com_IPduCfg" as ComCfg
  rectangle "PduR_Cfg.c\nLinIf Trigger/Conf Routes" as PduRCfg
  rectangle "LinIf_TxPduCfg\nFrameId + DLC + LinIfTxPduId" as LinIfCfg
}

' Layout hints
App -[hidden]down-> Com
Com -[hidden]down-> PduR
PduR -[hidden]down-> LinIf
LinIf -[hidden]down-> Lin
Lin -[hidden]down-> Hw
ComCfg -[hidden]right-> PduRCfg
PduRCfg -[hidden]right-> LinIfCfg

' Main runtime flow
App --> Com : 1. Com_SendSignal(...)\nCap nhat signal vao\nCOM shadow buffer
App --> LinIf : 2. LinIf_MainFunction()\nTick scheduler
LinIf --> PduR : 3. PduR_LinIfTriggerTransmit(...)
PduR --> Com : 4. Com_TriggerTransmit(...)
Com --> PduR : 5. Copy payload snapshot\nvao s_local_tx_buffer
PduR --> LinIf : 6. Return E_OK + payload
LinIf --> Lin : 7. Lin_SendFrame(...)
Lin --> Hw : 8. BREAK -> SYNC -> PID\n-> DATA -> CHECKSUM

' Confirmation path
App ..> LinIf : A. Vong lap sau:\nLinIf_MainFunction()
LinIf ..> Lin : B. Lin_GetStatus(0, NULL)
Lin ..> LinIf : C. LIN_TX_OK
LinIf ..> PduR : D. PduR_LinIfTxConfirmation(...)
PduR ..> Com : E. Com_TxConfirmation(...)

' Config lookups
Com ..> ComCfg : Tra cuu signal,\nbyte/bit, IPDU
PduR ..> PduRCfg : Tra cuu route\nLinIfTxPduId <-> ComTxPduId
LinIf ..> LinIfCfg : Tra cuu slot,\nFrame ID, DLC

note right of App
  Application khong push frame xuong bus.
  Application chi lam tuoi data trong COM.
end note

note left of LinIf
  LinIf la "ong chu lich":
  - tick % 10 == 5  -> HVACCtrl
  - tick % 10 == 0  -> LightCtrl
  - dung slot moi duoc keo data va phat frame
end note

note right of Lin
  Driver tinh PID tu raw Frame ID:
  - 0x10 -> PID 0x50
  - 0x11 -> PID 0x11
  Checksum = Enhanced
end note

legend bottom
  = Mui ten lien = runtime flow
  = Mui ten dut  = config lookup / confirmation
endlegend

@enduml
