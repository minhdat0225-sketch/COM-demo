:name: STM32F103 Interactive Dual Node Diagnostic Debug
:description: Interactive test with RX (diag_rx_demo) and paused TX (diag_tx_demo) for GDB trigger

# 1. Tạo Bus CAN giả lập
emulation CreateCANHub "canHub"

# ========================================================
# NODE 1: Transmitter (TX)
# ========================================================
mach create "Node_TX"
machine LoadPlatformDescription @debug/stm32f103_full.repl

connector Connect sysbus.can1 canHub

sysbus LoadELF $ORIGIN/../build/example/diag_tx_demo.elf

sysbus.usart1 CreateFileBackend $ORIGIN/../logs/tx_uart.log true
# Mở GDB port cho TX nhưng KHÔNG block chờ VS Code
machine StartGdbServer 3333

# ========================================================
# NODE 2: Receiver (RX)
# ========================================================
mach create "Node_RX"
machine LoadPlatformDescription @debug/stm32f103_full.repl

connector Connect sysbus.can1 canHub

sysbus LoadELF $ORIGIN/../build/example/diag_rx_demo.elf

# Mở cổng UART ra file rx_uart.log để giám sát
sysbus.usart1 CreateFileBackend $ORIGIN/../logs/rx_uart.log true

machine StartGdbServer 3334

# ========================================================
logLevel 3 sysbus
sysbus Log 2 "RENODE_IS_FULLY_READY_FOR_GDB"

# Start the emulation for BOTH nodes
start
